# Root .gitignore for RecapMe

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# AI / Agents
.agents/

# Logs
*.log
logs/

# Frontend (Node.js / Vite)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/*.tsbuildinfo

# Backend (Java / Maven / Spring Boot)
backend/target/
backend/.env
backend/.env.*
!backend/.env.example
backend/*.class
backend/*.jar
backend/*.war
