DB_URL=jdbc:postgresql://localhost:5432/recapme-db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DRIVER=org.postgresql.Driver
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Google Gemini / GenAI API Key (Required for Spring AI Recaps and Chat)
GOOGLE_GENAI_APIKEY=your_google_genai_api_key_here

# External Metadata GraphQL Endpoints
ANILIST_GRAPHQL_URL=https://graphql.anilist.co
KITSU_GRAPHQL_URL=https://kitsu.app/api/graphql

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
